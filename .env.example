# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
CHECKPOINT_CLIENT_ID=
CHECKPOINT_CLIENT_SECRET=
# Region is not a credential. Gateway compose may interpolate CHECKPOINT_REGION.
# Optional: us, eu, au, in. Auto-detected from the JWT when omitted.
CHECKPOINT_REGION=

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When MCP_HTTP_HOST is unset, the server binds 127.0.0.1.
# The container image sets 0.0.0.0 and requires a real CONDUIT_S2S_SECRET.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (for example changeme, replace-with-a-real-secret, your-s2s-secret).
# MCP_ALLOW_INSECURE_DEV=1 does not accept a placeholder. Compose will not
# start when this is unset. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Checkpoint-Client-Id and X-Checkpoint-Client-Secret headers; no env fallback).
# The container image and Compose file set gateway. Stdio ignores this and reads
# CHECKPOINT_* from the environment.
# AUTH_MODE=gateway

LOG_LEVEL=info
